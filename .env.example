EXECUTION_TARGET=disabled
ENABLE_SLAM=false
SLAM_RUNNER=/opt/slam/bin/slam_runner
SLAM_VOCAB=/opt/slam/share/orb_vocab.fbow
JOB_ROOT=/tmp/slam-jobs
MAX_VIDEO_SIZE_MB=200
MAX_VIDEO_DURATION_SECONDS=30
TARGET_PROCESSING_FPS=15
MAX_PROCESSING_WIDTH=640
DEFAULT_HORIZONTAL_FOV_DEGREES=65
ORB_MIN_AREA=800
ORB_NUM_LEVELS=8
FAST_THRESHOLD=20
MAX_DISPLAY_POINTS=10000
MAX_CONCURRENT_SLAM_JOBS=1
SLAM_PROCESS_TIMEOUT_SECONDS=90
JOB_TTL_SECONDS=1800
MAX_RETAINED_JOBS=10
OMP_NUM_THREADS=2
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_DIR=frontend/dist
