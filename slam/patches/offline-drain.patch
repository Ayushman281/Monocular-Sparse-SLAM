+bool system::wait_for_pending_work(double timeout_seconds) const {
+    const auto deadline = std::chrono::steady_clock::now()
+        + std::chrono::duration<double>(timeout_seconds);
+    do {
+        if (mapper_->work_is_idle()
+            && (!global_optimizer_ || global_optimizer_->work_is_idle())
+            && !loop_BA_is_running()) {
+            return true;
+        }
+        // Synchronization wait, never a playback/frame-rate delay.
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    } while (std::chrono::steady_clock::now() < deadline);
+    return false;
+}
